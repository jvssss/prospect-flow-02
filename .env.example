# --- Supabase (projeto vmnaatcwginshkpedwoc; os valores públicos já estão no .env) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Necessárias para a API e a automação ---
# Chave de serviço do Supabase (Settings > API > service_role). NUNCA exponha no navegador.
# Sem ela: chaves de API e a rotina automática não funcionam.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo da rotina automática. Gere um valor longo e aleatório, ex.: openssl rand -hex 32
# O agendador chama POST /api/cron/enrich com "Authorization: Bearer <este valor>".
CRON_SECRET=

# --- Resumo do closer por IA (qualificação) ---
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-haiku-5-5
ANTHROPIC_MODEL=

# --- Busca de leads por cidade ("Adquirir mais leads") ---
APIFY_TOKEN=

# --- Opcionais ---
# Origem alternativa dos arquivos /rfb/*.json (padrão: o próprio domínio do app).
RFB_BASE_URL=
# Chave paga da CNPJá. Não é usada pela API nova; só pelo fluxo antigo do painel.
CNPJA_API_KEY=
